module.exports = "vec2 extrude(vec2 other, float angle, float length) {\r\n    float x = length * cos(angle);\r\n    float y = length * sin(angle);\r\n\r\n    return vec2(other.x + x, other.y + y);\r\n}\r\n\r\n//float getHeightAt(vec2 texCoord, float xyAngle, float distance, sampler2D heightMap) {\r\n//\r\n//    vec2 newTexCoord = extrude(texCoord, xyAngle, distance);\r\n//    return texture2D(heightMap, newTexCoord).a;\r\n//}\r\n//\r\n//float getTraceHeight(float height, float zAngle, float distance) {\r\n//    return distance * tan(zAngle) + height;\r\n//}\r\n\r\nfloat getShadowAlpha(float xyAngle, float zAngle, sampler2D heightMap, vec2 texCoord, float step) {\r\n    float distance;\r\n    float height;\r\n    float otherHeight;\r\n    float traceHeight;\r\n\r\n    height = texture2D(heightMap, texCoord).a;\r\n    for(int i = 0; i < %SHADOW_DIST%; ++i) {\r\n        distance = step * float(i);\r\n\r\n        // getHeightAt\r\n        vec2 newTexCoord = extrude(texCoord, xyAngle, distance);\r\n        otherHeight = texture2D(heightMap, newTexCoord).a;\r\n\r\n        if(otherHeight > height) {\r\n            // getTraceHeight\r\n            traceHeight = distance * tan(zAngle) + height;\r\n            if(traceHeight <= otherHeight) {\r\n                return float(i);\r\n            }\r\n        }\r\n    }\r\n\r\n    return 0.;\r\n}\r\n\r\nvarying vec2 vTextureCoord;\r\nuniform sampler2D uSampler;\r\nuniform float uXYAngle;\r\nuniform float uZAngle;\r\nuniform float uTexStep;\r\nuniform vec4 uColor;\r\n\r\nvoid main(void) {\r\n    //    vec4 pixel = texture2D(uSampler, vTextureCoord);\r\n    float shadowAlpha = getShadowAlpha(uXYAngle, uZAngle, uSampler, vTextureCoord, uTexStep);\r\n    if(shadowAlpha != 0.0) {\r\n        gl_FragColor = vec4(0, 0, 0, 0.5);\r\n        return;\r\n    }\r\n    discard;\r\n    //    gl_FragColor =  vec4(0, 0, 0, 0.0);\r\n}\r\n"